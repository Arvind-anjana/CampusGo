{
  "expo": {
    "name": "NavGO",
    "slug": "NavGO",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/NavGO.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/NavGO.png",
        "backgroundImage": "./assets/NavGO.png",
        "monochromeImage": "./assets/NavGO.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.NavGO"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/NavGO.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/NavGO.png",
          "imageWidth": 76
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
